[Desktop Entry]
Name=Panel
Comment=Configure panels, their appearance and the items they contain
Exec=mate-panel-properties
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon=mate-panel
Terminal=false
Type=Application
StartupNotify=true
Categories=GTK;Settings;DesktopSettings;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=mate-control-center;MATE;panel;taskbar;applet;launcher;dock;properties;preferences;
OnlyShowIn=MATE;
