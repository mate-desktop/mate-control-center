msgid "<guimenu>System</guimenu> menu"
msgstr "ເມນູ <guimenu>ລະບົບ</guimenu>"

#. (itstool) path: listitem/para
#: C/index.docbook:100
msgid ""
"Choose <menuchoice><guimenu>Control Center</guimenu></menuchoice> menu item."
msgstr "ເລືອກລາຍການເມນູ <menuchoice><guimenu>ສູນຄວບຄຸມ</guimenu></menuchoice>."

#. (itstool) path: varlistentry/term
#: C/index.docbook:106
msgid "Command line"
msgstr "ເຄື່ອງມືຄຳສັ່ງ (Command line)"

#. (itstool) path: listitem/para
#: C/index.docbook:108
msgid "Execute the following command: <command>mate-control-center</command>"
msgstr "ໃຊ້ຄຳສັ່ງຕໍ່ໄປນີ້: <command>mate-control-center</command>"

#. (itstool) path: sect1/title
#: C/index.docbook:118
msgid "Usage"
msgstr "ການໃຊ້ງານ"

#. (itstool) path: sect1/para
#: C/index.docbook:119
msgid ""
"The <application>MATE Control Center</application> window lists all "
"preference tools installed on your system in groups."
msgstr ""
"ປ່ອງຢ້ຽມ <application>ສູນຄວບຄຸມ MATE</application> ຈະສະແດງລາຍຊື່ເຄື່ອງມືການຕັ້ງຄ່າທັງໝົດທີ່ຕິດ"
"ຕັ້ງຢູ່ໃນລະບົບຂອງເຈົ້າໂດຍແຍກເປັນໝວດໝູ່."

#. (itstool) path: tip/para
#: C/index.docbook:122
msgid ""
"From the left pane, you can quickly access to a preference tool by selecting"
" its group first, or type any keyword in the filter box. You can also access"
" to common tasks, such as <guilabel>Change Theme</guilabel>, and "
"<guilabel>Set Preferred Applications</guilabel>."
msgstr ""
"ຈາກແຖບດ້ານຊ້າຍ, ເຈົ້າສາມາດເຂົ້າເຖິງເຄື່ອງມືການຕັ້ງຄ່າໄດ້ຢ່າງວ່ອງໄວໂດຍການເລືອກໝວດໝູ່ຂອງມັນກ່ອນ, ຫຼື ພິ"
"ມຄຳສັບໃດໜຶ່ງລົງໃນຊ່ອງກອງຂໍ້ມູນ. ເຈົ້າຍັງສາມາດເຂົ້າເຖິງວຽກງານທົ່ວໄປໄດ້ ເຊັ່ນ: <guilabel>ປ່ຽນຮູບແບບ "
"(Theme)</guilabel>, ແລະ <guilabel>ຕັ້ງຄ່າແອັບພລິເຄຊັນທີ່ຕ້ອງການ</guilabel>."

#. (itstool) path: sect1/para
#: C/index.docbook:125
msgid "To open a preference tool, just click on it."
msgstr "ເພື່ອເປີດເຄື່ອງມືການຕັ້ງຄ່າ, ພຽງແຕ່ຄລິກໃສ່ມັນ."

#. (itstool) path: tip/para
#: C/index.docbook:128
msgid "The preference tool description is shown on mouse hover."
msgstr ""
"ຄຳອະທິບາຍຂອງເຄື່ອງມືການຕັ້ງຄ່າຈະສະແດງຂຶ້ນເມື່ອເອົາເມົາສ໌ໄປວາງໄວ້ເທິງນັ້ນ."

#. (itstool) path: abstract/para
#: C/config-accessibility-keyboard.xml:3
msgid ""
"Adjusts the extended keyboard capabilities, in order to facilitate the use "
"of the keyboard by those users with additional needs."
msgstr ""
"ປັບແຕ່ງຄວາມສາມາດເພີ່ມເຕີມຂອງແປ້ນພິມ ເພື່ອອຳນວຍຄວາມສະດວກໃນການໃຊ້ແປ້ນພິມສຳລັບຜູ້ໃຊ້ທີ່ມີຄວາມຕ້ອງການ"
"ພິເສດ."

#. (itstool) path: sect1/title
#: C/config-accessibility-keyboard.xml:5
msgid "Keyboard Accessibility (AccessX)"
msgstr "ການເຂົ້າເຖິງແປ້ນພິມ (AccessX)"

