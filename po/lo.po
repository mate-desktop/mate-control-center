#: capplets/about-me/mate-about-me-fingerprint.c:123
msgid ""
"You are not allowed to access the device. Contact your system administrator."
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ເຂົ້າເຖິງອຸປະກອນນີ້. ກະລຸນາຕິດຕໍ່ຜູ້ດູແລລະບົບ."

#: capplets/about-me/mate-about-me-fingerprint.c:125
msgid "The device is already in use."
msgstr "ອຸປະກອນນີ້ກຳລັງຖືກໃຊ້ງານຢູ່."

#: capplets/about-me/mate-about-me-fingerprint.c:127
msgid "An internal error occurred"
msgstr "ເກີດຂໍ້ຜິດພາດພາຍໃນ"

#: capplets/about-me/mate-about-me-fingerprint.c:270
msgid "Delete registered fingerprints?"
msgstr "ລຶບລາຍນິ້ວມືທີ່ລົງທະບຽນໄວ້ບໍ່?"

#: capplets/about-me/mate-about-me-fingerprint.c:273
msgid "_Delete Fingerprints"
msgstr "_ລຶບລາຍນິ້ວມື"

#: capplets/about-me/mate-about-me-fingerprint.c:280
msgid ""
"Do you want to delete your registered fingerprints so fingerprint login is "
"disabled?"
msgstr ""
"ທ່ານຕ້ອງການລຶບລາຍນິ້ວມືທີ່ລົງທະບຽນໄວ້ເພື່ອປິດການເຂົ້າລະບົບດ້ວຍລາຍນິ້ວມືບໍ່?"

#: capplets/about-me/mate-about-me-fingerprint.c:445
#: capplets/about-me/mate-about-me-fingerprint.ui:344
msgid "Done!"
msgstr "ສຳເລັດແລ້ວ!"

#: capplets/about-me/mate-about-me-fingerprint.c:520
#: capplets/about-me/mate-about-me-fingerprint.c:565
#, c-format
msgid "Could not access '%s' device"
msgstr "ບໍ່ສາມາດເຂົ້າເຖິງອຸປະກອນ '%s'"

#: capplets/about-me/mate-about-me-fingerprint.c:626
#, c-format
msgid "Could not start finger capture on '%s' device"
msgstr "ບໍ່ສາມາດເລີ່ມການອ່ານລາຍນິ້ວມືໃນອຸປະກອນ '%s'"

#: capplets/about-me/mate-about-me-fingerprint.c:696
msgid "Could not access any fingerprint readers"
msgstr "ບໍ່ສາມາດເຂົ້າເຖິງເຄື່ອງອ່ານລາຍນິ້ວມືໃດໆ"

#: capplets/about-me/mate-about-me-fingerprint.c:697
msgid "Please contact your system administrator for help."
msgstr "ກະລຸນາຕິດຕໍ່ຜູ້ດູແລລະບົບເພື່ອຂໍຄວາມຊ່ວຍເຫຼືອ."

#: capplets/about-me/mate-about-me-fingerprint.c:761
#: capplets/about-me/mate-about-me-fingerprint.ui:66
msgid "Enable Fingerprint Login"
msgstr "ເປີດໃຊ້ການເຂົ້າລະບົບດ້ວຍລາຍນິ້ວມື"

#: capplets/about-me/mate-about-me-fingerprint.c:798
#, c-format
msgid ""
"To enable fingerprint login, you need to save one of your fingerprints, "
"using the '%s' device."
msgstr ""
"ເພື່ອເປີດໃຊ້ການເຂົ້າລະບົບດ້ວຍລາຍນິ້ວມື, ທ່ານຕ້ອງບັນທຶກລາຍນິ້ວມືໜຶ່ງຂອງທ່ານກ່ອນ ໂດຍໃຊ້ໝໍ້ອຸປະກອນ '%s'."

#: capplets/about-me/mate-about-me-fingerprint.c:807
