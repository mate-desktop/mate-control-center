#: org.mate.control-center.gschema.xml.in:5
msgid ""
"[ 'Change Theme;mate-appearance-properties.desktop', 'Set Preferred "
"Applications;mate-default-applications-properties.desktop' ]"
msgstr ""
"[ 'ປ່ຽນຮູບແບບ;mate-appearance-properties.desktop', 'ຕັ້ງຄ່າແອັບພລິເຄຊັນທີ່ຕ້ອງການ;mate-"
"default-applications-properties.desktop' ]"

#: org.mate.control-center.gschema.xml.in:6
msgid "Task names and associated .desktop files"
msgstr "ຊື່ວຽກ ແລະ ໄຟລ໌ .desktop ທີ່ກ່ຽວຂ້ອງ"

#: org.mate.control-center.gschema.xml.in:7
msgid ""
"The task name to be displayed in the control-center followed by a \";\" "
"separator then the filename of an associated .desktop file to launch for "
"that task."
msgstr ""
"ຊື່ວຽກທີ່ຈະສະແດງໃນສູນຄວບຄຸມ ຕາມດ້ວຍເຄື່ອງໝາຍ \";\" ຂັ້ນ ແລ້ວຕາມດ້ວຍຊື່ໄຟລ໌ .desktop ທີ່ກ່ຽວຂ້ອງເພື່"
"ອເປີດວຽກນັ້ນ."

#: org.mate.control-center.gschema.xml.in:11
msgid "Close the control-center when a task is activated"
msgstr "ປິດສູນຄວບຄຸມເມື່ອວຽກຖືກເປີດໃຊ້"

#: org.mate.control-center.gschema.xml.in:12
msgid ""
"if true, the control-center will close when a \"Common Task\" is activated."
msgstr "ຖ້າເລືອກ, ສູນຄວບຄຸມຈະປິດລົງເມື່ອ \"ວຽກທົ່ວໄປ\" ຖືກເປີດໃຊ້."

#: org.mate.control-center.gschema.xml.in:16
msgid "Exit shell on start action performed"
msgstr "ອອກຈາກ Shell ເມື່ອເລີ່ມການເຮັດວຽກ"

#: org.mate.control-center.gschema.xml.in:17
msgid "Indicates whether to close the shell when a start action is performed."
msgstr "ລະບຸວ່າຈະໃຫ້ປິດ Shell ຫຼື ບໍ່ ເມື່ອມີການເລີ່ມການເຮັດວຽກ."

#: org.mate.control-center.gschema.xml.in:21
msgid "Exit shell on help action performed"
msgstr "ອອກຈາກ Shell ເມື່ອເປີດການຊ່ວຍເຫຼືອ"

#: org.mate.control-center.gschema.xml.in:22
msgid "Indicates whether to close the shell when a help action is performed."
msgstr "ລະບຸວ່າຈະໃຫ້ປິດ Shell ຫຼື ບໍ່ ເມື່ອມີການເປີດການຊ່ວຍເຫຼືອ."

#: org.mate.control-center.gschema.xml.in:26
msgid "Exit shell on add or remove action performed"
msgstr "ອອກຈາກ Shell ເມື່ອມີການເພີ່ມ ຫຼື ລຶບ"

#: org.mate.control-center.gschema.xml.in:27
msgid ""
"Indicates whether to close the shell when an add or remove action is "
"performed."
msgstr "ລະບຸວ່າຈະໃຫ້ປິດ Shell ຫຼື ບໍ່ ເມື່ອມີການເພີ່ມ ຫຼື ລຶບ."

#: org.mate.control-center.gschema.xml.in:31
msgid "Exit shell on upgrade or uninstall action performed"
msgstr "ອອກຈາກ Shell ເມື່ອມີການອັບເກຣດ ຫຼື ຖອນການຕິດຕັ້ງ"

#: org.mate.control-center.gschema.xml.in:32
msgid ""
"Indicates whether to close the shell when an upgrade or uninstall action is "
"performed."
msgstr "ລະບຸວ່າຈະໃຫ້ປິດ Shell ຫຼື ບໍ່ ເມື່ອມີການອັບເກຣດ ຫຼື ຖອນການຕິດຕັ້ງ."

#: org.mate.control-center.gschema.xml.in:38
msgid "More backgrounds URL"
msgstr "URL ສຳລັບພື້ນຫຼັງເພີ່ມເຕີມ"

#: org.mate.control-center.gschema.xml.in:39
msgid ""
"URL for where to get more desktop backgrounds. If set to an empty string the"
" link will not appear."
msgstr ""
"URL ສຳລັບດາວໂຫຼດຮູບພື້ນຫຼັງໜ້າຈໍເພີ່ມເຕີມ. ຖ້າປະວ່າງໄວ້ ລິງກ໌ຈະບໍ່ສະແດງ."

#: org.mate.control-center.gschema.xml.in:43
msgid "More themes URL"
msgstr "URL ສຳລັບຮູບແບບເພີ່ມເຕີມ"

#: org.mate.control-center.gschema.xml.in:44
msgid ""
"URL for where to get more desktop themes. If set to an empty string the link"
" will not appear."
msgstr "URL ສຳລັບດາວໂຫຼດຮູບແບບໜ້າຈໍເພີ່ມເຕີມ. ຖ້າປະວ່າງໄວ້ ລິງກ໌ຈະບໍ່ສະແດງ."

#: org.mate.control-center.keybinding.gschema.xml.in:5
msgid "Keybinding"
msgstr "ປຸ່ມລັດ"

#: org.mate.control-center.keybinding.gschema.xml.in:6
msgid "Keybinding associated with a custom shortcut."
msgstr "ປຸ່ມລັດທີ່ກ່ຽວຂ້ອງກັບການຕັ້ງຄ່າປຸ່ມລັດເອງ."

#: org.mate.control-center.keybinding.gschema.xml.in:10
msgid "Command"
msgstr "ຄຳສັ່ງ"

#: org.mate.control-center.keybinding.gschema.xml.in:11
msgid "Command associated with a custom keybinding."
msgstr "ຄຳສັ່ງທີ່ກ່ຽວຂ້ອງກັບປຸ່ມລັດທີ່ຕັ້ງຄ່າເອງ."

#: org.mate.control-center.keybinding.gschema.xml.in:15
#: font-viewer/font-view.c:202
msgid "Name"
msgstr "ຊື່"

#: org.mate.control-center.keybinding.gschema.xml.in:16
msgid "Description associated with a custom keybinding."
msgstr "ຄຳອະທິບາຍທີ່ກ່ຽວຂ້ອງກັບປຸ່ມລັດທີ່ຕັ້ງຄ່າເອງ."

